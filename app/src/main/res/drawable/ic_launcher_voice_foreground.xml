        android:pathData="M 39,73 a 5,4 30 1 0 8,-1.5 a 5,4 30 1 0 -8,1.5"
        android:fillColor="#FFFFFF" />

    <!-- Right Note Head (Slanted Ellipse centered around 64, 67) -->
    <path
        android:pathData="M 59,67 a 5,4 30 1 0 8,-1.5 a 5,4 30 1 0 -8,1.5"
        android:fillColor="#FFFFFF" />

    <!-- Left Vertical Stem (X: 46 to 49.5, Y: 43 to 71) -->
    <path
        android:pathData="M 46,43 h 3.5 v 28 h -3.5 z"
        android:fillColor="#FFFFFF" />

    <!-- Right Vertical Stem (X: 66 to 69.5, Y: 37 to 65) -->
    <path
        android:pathData="M 66,37 h 3.5 v 28 h -3.5 z"
        android:fillColor="#FFFFFF" />

    <!-- Top Connecting Beam (Slanted from Left stem top to Right stem top) -->
